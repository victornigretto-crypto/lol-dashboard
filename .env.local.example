NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cle service_role de Supabase (Dashboard > Project Settings > API > service_role).
# Sert UNIQUEMENT au cache partage des parties (table match_facts), qui n'a pas
# de proprietaire : un visiteur anonyme n'a pas d'auth.uid(), donc aucune policy
# RLS ne peut l'autoriser a ecrire.
#
# Elle contourne RLS : ne jamais la prefixer NEXT_PUBLIC_, ne jamais l'importer
# dans un composant client. Sans elle l'app fonctionne, mais sans cache : chaque
# recherche retelecharge les 20 parties depuis l'API Riot.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
